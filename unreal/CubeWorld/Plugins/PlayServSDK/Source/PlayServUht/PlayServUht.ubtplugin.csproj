<Project Sdk="Microsoft.NET.Sdk">
  <!-- PlayServ SDK UHT plugin — compile-time entity registration, descriptors and schema manifest.
       UBT auto-compiles and loads this assembly into UHT for any target with PlayServSDK enabled.
       $(EngineDir) is passed as an MSBuild global property by UBT (CsProjBuilder.cs). -->
  <Import Project="$(EngineDir)\Source\Programs\Shared\UnrealEngine.csproj.props" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Development</Configuration>
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <Configurations>Debug;Release;Development</Configurations>
    <RootNamespace>PlayServUht</RootNamespace>
    <AssemblyName>PlayServUht</AssemblyName>
    <!-- Keep build artifacts out of Source\ so Rocket packaging ships sources only
         (each engine compiles its own assembly — no cross-engine staleness).
         obj\ relocation lives in Directory.Build.props (must precede Common.props).
         GetFullPath: UE 5.8's UBT rejects literal ".." segments in this path when it
         builds the non-editor makefile ("'..' can be only added at the beginning"). -->
    <OutputPath>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\Intermediate\PlayServUht\bin\'))</OutputPath>
    <DebugType>pdbonly</DebugType>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false: reference engine assemblies in place, never copy the UBT closure
         next to our output (it bloated Rocket packages by ~70 DLLs in the spike). -->
    <Reference Include="EpicGames.Build">
      <HintPath>$(EngineDir)\Binaries\DotNET\UnrealBuildTool\EpicGames.Build.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="EpicGames.Core">
      <HintPath>$(EngineDir)\Binaries\DotNET\UnrealBuildTool\EpicGames.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="EpicGames.UHT">
      <HintPath>$(EngineDir)\Binaries\DotNET\UnrealBuildTool\EpicGames.UHT.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnrealBuildTool">
      <HintPath>$(EngineDir)\Binaries\DotNET\UnrealBuildTool\UnrealBuildTool.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>$(EngineDir)\Binaries\DotNET\UnrealBuildTool\Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
