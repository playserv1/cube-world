<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="playserv" value="https://nuget.dev.playserv.com/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="playserv">
      <package pattern="PlayServ.Sdk*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
